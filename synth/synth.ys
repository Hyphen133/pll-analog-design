# Generic (PDK-less) synthesis of the Tiny Tapeout top level.  This is a fast
# sanity check that the design maps to gates; the real hardening happens in the
# tt-gds-action workflow (IHP SG13G2) or via `make layout` (Sky130).
read_verilog -sv src/adpll.v src/tt_um_hyphen133_adpll.v
hierarchy -check -top tt_um_hyphen133_adpll

proc
opt
check
fsm
opt
memory
opt
techmap
opt
abc
clean

stat
check
write_verilog -noattr build/tt_um_hyphen133_adpll_synth.v
write_json build/tt_um_hyphen133_adpll_synth.json
